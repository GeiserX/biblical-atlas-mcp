{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GeiserX/biblical-atlas-mcp",
  "title": "Biblical Atlas",
  "description": "Spanish Bible atlas as MCP tools: people, places, events, passages, each linked to its source",
  "websiteUrl": "https://github.com/GeiserX/biblical-atlas-mcp",
  "icons": [
    {
      "src": "https://biblical-atlas.geiser.cloud/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://biblical-atlas.geiser.cloud/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/GeiserX/biblical-atlas-mcp",
    "source": "github",
    "id": "1398284986"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "biblical-atlas-mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BIBLICAL_ATLAS_DATA_URL",
          "description": "Data file URL (default https://biblical-atlas.geiser.cloud/data.json)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "BIBLICAL_ATLAS_DATA_FILE",
          "description": "Path to a local copy of the data file; no network when set",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "BIBLICAL_ATLAS_CACHE_DIR",
          "description": "Disk cache directory, or off",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "BIBLICAL_ATLAS_REFRESH",
          "description": "How long a copy is served before asking again (default 1h, 0 = never)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "BIBLICAL_ATLAS_TIMEOUT",
          "description": "Limit for one download, a Go duration from 1s to 5m (default 30s)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
