# Every setting is optional. Values shown are the defaults.

# Where to download the data file.
# BIBLICAL_ATLAS_DATA_URL=https://biblical-atlas.geiser.cloud/data.json

# Path to a local copy. When set, no network is used and the URL is ignored.
# BIBLICAL_ATLAS_DATA_FILE=

# Where the downloaded file is kept between runs; "off" disables the disk cache.
# Default: <user cache dir>/biblical-atlas-mcp
# BIBLICAL_ATLAS_CACHE_DIR=

# How long a copy is served before the server asks again (at least 1m, 0 = never).
# BIBLICAL_ATLAS_REFRESH=1h

# Limit for one download (1s to 5m).
# BIBLICAL_ATLAS_TIMEOUT=30s

# stdio, or http (the default when unset).
# TRANSPORT=http

# HTTP listen address. The container image sets 0.0.0.0:8080.
# LISTEN_ADDR=127.0.0.1:8080

# When set, HTTP requests need "Authorization: Bearer <token>".
# MCP_AUTH_TOKEN=
